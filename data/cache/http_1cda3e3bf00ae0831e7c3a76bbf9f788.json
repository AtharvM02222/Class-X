Align=\"top\" align=\"left\" width=\"250\"><b> <a href=\"web_material/SQP/ClassX_2024_25/HindiCourseA-MS.pdf\" target=\"_blank\">MS</a> </b> </td>\r\n    </tr>\r\n  <tr>\r\n    <td height=\"5\" vAlign=\"top\" align=\"left\" width=\"250\"><b>Hindi B</b></td>\r\n    <td height=\"5\" vAlign=\"top\" align=\"left\" width=\"250\"><b> <a href=\"web_material/SQP/ClassX_2024_25/HindiCourseB-SQP.pdf\" target=\"_blank\">SQP</a> </b> </td>\r\n    <td vAlign=\"top\" align=\"left\" width=\"250\"><b> <a href=\"web_material/SQP/ClassX_2024_25/HindiCourseB-MS.pdf\" target=\"_blank\">MS</a> </b> </td>\r\n    </tr>\r\n  <tr>\r\n    <td height=\"5\" vAlign=\"top\" align=\"left\" width=\"250\"><b>Home Science</b></td>\r\n    <td height=\"5\" vAlign=\"top\" align=\"left\" width=\"250\"><b><a href=\"web_material/SQP/ClassX_2024_25/HomeScience-SQP.pdf\" target=\"_blank\">SQP</a></b> </td>\r\n    <td vAlign=\"top\" align=\"left\" width=\"250\"><b><a href=\"web_material/SQP/ClassX_2024_25/HomeScience-MS.pdf\" target=\"_blank\">MS</a></b> </td>\r\n    </tr>\r\n  <tr>\r\n    <td height=\"5\" vAlign=\"top\" align=\"left\" width=\"250\"><b>Computer Application</b></td>\r\n    <td height=\"5\" vAlign=\"top\" align=\"left\" width=\"250\"><b><a href=\"web_material/SQP/ClassX_2024_25/ComputerApplication-SQP.pdf\" target=\"_blank\">SQP</a></b> </td>\r\n    <td vAlign=\"top\" align=\"left\" width=\"250\"><b><a href=\"web_material/SQP/ClassX_2024_25/ComputerApplication-MS.pdf\" target=\"_blank\">MS</a></b> </td>\r\n    </tr>\r\n  <!--<tr>\r\n                              <td height=\"5\" vAlign=\"top\" align=\"left\" width=\"250\"><b>Information and Communication Technology</b></td>\r\n                              <td height=\"5\" vAlign=\"top\" align=\"left\" width=\"250\"><b><a href=\"web_material/SQP/ClassX_2024_25/ICT-SQP.pdf\" target=\"_blank\">SQP</a></b> </td>\r\n                              <td height=\"5\" vAlign=\"top\" align=\"left\" width=\"250\"><b><a href=\"web_material/SQP/ClassX_2024_25/ICT-PQ.pdf\" target=\"_blank\">PQ</a></b></td>\r\n  </tr>-->\r\n  <tr>\r\n    <td height=\"5\" vAlign=\"top\" align=\"left\" width=\"250\"><b>Mathematics (Basic)</b></td>\r\n    <td height=\"5\" vAlign=\"top\" align=\"left\" width=\"250\"><b><a href=\"web_material/SQP/ClassX_2024_25/MathsBasic-SQP.pdf\" target=\"_blank\">SQP</a></b> </td>\r\n    <td><b><a href=\"web_material/SQP/ClassX_2024_25/MathsBasic-MS.pdf\" target=\"_blank\">MS</a></b></td>\r\n    </tr>\r\n  <tr>\r\n    <td height=\"5\" vAlign=\"top\" align=\"left\" width=\"250\"><b>Mathematics (Basic) (For Visually Impaired)</b></td>\r\n    <td height=\"5\" vAlign=\"top\" align=\"left\" width=\"250\"><b><a href=\"web_material/SQP/ClassX_2024_25/MathsBasicVIC-SQP.pdf\" target=\"_blank\">SQP</a></b> </td>\r\n    <td><b><a href=\"web_material/SQP/ClassX_2024_25/MathsBasicVIC-MS.pdf\" target=\"_blank\">MS</a></b></td>\r\n    </tr>\r\n  <tr>\r\n    <td height=\"5\" vAlign=\"top\" align=\"left\" width=\"250\"><b>Mathematics (Standard)</b></td>\r\n    <td height=\"5\" vAlign=\"top\" align=\"left\" width=\"250\"><b><a href=\"web_material/SQP/ClassX_2024_25/MathsStandard-SQP.pdf\" target=\"_blank\">SQP</a></b> </td>\r\n    <td><b><a href=\"web_material/SQP/ClassX_2024_25/MathsStandard-MS.pdf\" target=\"_blank\">MS</a></b></td>\r\n    </tr>\r\n  <tr>\r\n    <td height=\"5\" vAlign=\"top\" align=\"left\" width=\"250\"><b>Mathematics (Standard) (For Visually Impaired)</b></td>\r\n    <td height=\"5\" vAlign=\"top\" align=\"left\" width=\"250\"><b><a href=\"web_material/SQP/ClassX_2024_25/MathsStandardVIC-SQP.pdf\" target=\"_blank\">SQP</a></b> </td>\r\n    <td><b><a href=\"web_material/SQP/ClassX_2024_25/MathsStandardVIC-MS.pdf\" target=\"_blank\">MS</a></b></td>\r\n    </tr>\r\n  <tr>\r\n    <td height=\"5\" vAlign=\"top\" align=\"left\" width=\"250\"><b>Social Science</b></td>\r\n    <td height=\"5\" vAlign=\"top\" align=\"left\" width=\"250\"><b><a href=\"web_material/SQP/ClassX_2024_25/SocialScience-SQP.pdf\" targ